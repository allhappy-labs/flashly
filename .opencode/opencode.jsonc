{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md",
    ".claude/skills/*.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git stash list*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "npm *": "ask",
      "grep *": "allow",
    },
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
    },
  },
}
