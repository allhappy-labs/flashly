{
    "name": "@flashly/api",
    "version": "1.0.0",
    "description": "Flashly Fastify API",
    "main": "app.ts",
    "exports": {
        ".": "./app.ts",
        "./trpc": "./lib/trpc/index.ts"
    },
    "type": "module",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "test": "tsc -p test/tsconfig.json && NODE_ENV=test E2E_AUTH_SECRET='FlashlyTestAuthSecret2026X9Secure' E2E_TEST_USER_PASSWORD='FlashlyTestPass!2026' c8 node --experimental-strip-types --test \"test/**/*.test.ts\"",
        "start": "node --experimental-strip-types app.ts",
        "init": "pnpm --filter @flashly/email-templates build && pnpm db:init",
        "dev": "pnpm --filter @flashly/shared build && pnpm run kill:dev && fastify start -w -l ${LOG_LEVEL:-info} app.ts",
        "kill:dev": "lsof -ti :3001 | xargs -r kill -9 || true",
        "docker:dev": "npm run dev",
        "docker:start": "npm run start",
        "db:init": "node --experimental-strip-types --env-file=.env scripts/init-db.ts && pnpm exec drizzle-kit push",
        "lint": "oxlint .",
        "check:no-ts-nocheck": "node scripts/check-no-ts-nocheck.mjs",
        "check:no-inline-route-error-mapping": "node scripts/check-no-inline-route-error-mapping.mjs",
        "check:types": "pnpm run check:no-ts-nocheck && pnpm run check:no-inline-route-error-mapping && tsc --noEmit",
        "setup:s3": "node --experimental-strip-types --env-file=.env scripts/setup-s3.ts",
        "verify:s3": "node --experimental-strip-types --env-file=.env scripts/verify-s3.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1095.0",
        "@aws-sdk/s3-request-presigner": "^3.1095.0",
        "@better-auth/expo": "1.4.22",
        "@better-upload/server": "^3.0.19",
        "@fastify/autoload": "^6.5.0",
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/rate-limit": "^11.1.0",
        "@fastify/sensible": "^6.0.4",
        "@flashly/api-contracts": "workspace:*",
        "@flashly/email-templates": "workspace:*",
        "@flashly/shared": "workspace:*",
        "@sentry/node": "^10.68.0",
        "@trpc/server": "^11.18.0",
        "@upyo/core": "^0.5.1",
        "@upyo/plunk": "^0.5.1",
        "autumn-js": "^0.1.85",
        "better-auth": "1.4.22",
        "close-with-grace": "^2.5.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "fastify": "^5.10.0",
        "fastify-cli": "^8.0.0",
        "fastify-plugin": "^6.0.0",
        "fastify-type-provider-zod": "^7.0.0",
        "file-type": "^22.0.1",
        "ioredis": "^5.11.1",
        "neverthrow": "^8.2.0",
        "pdf-parse": "^2.4.5",
        "pg": "^8.22.0",
        "pino-pretty": "^13.1.3",
        "remove-markdown": "^0.6.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "c8": "^12.0.0",
        "concurrently": "^10.0.4",
        "drizzle-kit": "^0.31.10",
        "fastify-tsconfig": "^3.0.0",
        "typescript": "~6.0.3"
    }
}
