---
import FeatureOverview from "@/components/FeatureOverview.astro";
import GeneratorTeaser from "@/components/GeneratorTeaser.astro";
import ImageMod from "@/components/ImageMod.astro";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import { markdownify } from "@/lib/utils/textConverter";

const { useCase, testimonial, call_to_action } = Astro.props as {
  useCase: any;
  testimonial: any;
  call_to_action: any;
};

const { hero, feature_overview, generator } = useCase.data;
---

<section class="hero">
  <div class="container">
    <div class="row items-center">
      <div class="lg:col-6">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 set:html={markdownify(hero.title)} class="mb-4 text-h2 lg:text-h1" />
        <p set:html={markdownify(hero.content)} class="mb-8 text-lg" />
        <div class="flex flex-wrap gap-4">
          {hero.primary_button.enable && (
            <a class="btn btn-primary" href={hero.primary_button.link}>
              {hero.primary_button.label}
            </a>
          )}
          {hero.secondary_button.enable && (
            <a class="btn btn-outline-primary" href={hero.secondary_button.link}>
              {hero.secondary_button.label}
            </a>
          )}
        </div>
      </div>
      <div class="lg:col-6">
        {hero.image && (
          <ImageMod
            src={hero.image}
            height={520}
            width={720}
            alt={`${hero.eyebrow} hero`}
            format="webp"
          />
        )}
      </div>
    </div>
  </div>
</section>

<FeatureOverview
  title={feature_overview.title}
  description={feature_overview.description}
  items={feature_overview.items}
/>

<div id="how-it-works">
  <GeneratorTeaser
    title={generator.title}
    description={generator.description}
    steps={generator.steps}
    inputLabel={generator.input_label}
    outputLabel={generator.output_label}
    sampleInput={generator.sample_input}
    sampleOutput={generator.sample_output}
    button={generator.button}
  />
</div>

<Testimonial testimonial={testimonial} />
<CallToAction call_to_action={call_to_action} />
