{
  "name": "@flashly/promo",
  "version": "5.12.0",
  "description": "Astro and Tailwindcss Multilingual boilerplate",
  "author": "zeon.studio",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"pnpm generate-json && astro dev\"",
    "build": "node scripts/themeGenerator.js && pnpm generate-json && astro build",
    "preview": "astro preview",
    "format": "prettier -w ./src",
    "check": "astro check",
    "generate-json": "node scripts/jsonGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && pnpm format",
    "remove-multilang": "node scripts/removeMultilang.js && pnpm format"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "4.3.13",
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.7.3",
    "@digi4care/astro-google-tagmanager": "^1.6.0",
    "@flashly/branding": "workspace:*",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "5.16.11",
    "astro-auto-import": "^0.5.2",
    "astro-font": "^1.1.0",
    "astro-swiper": "^2.8.1",
    "date-fns": "^4.4.0",
    "disqus-react": "^1.1.7",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "neverthrow": "^8.2.0",
    "prop-types": "^15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.7.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.3",
    "vite": "^7.3.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
